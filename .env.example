# PostgreSQL operational source
COMMERCE_POSTGRES_DB=commerce
COMMERCE_POSTGRES_USER=commerce_app
COMMERCE_POSTGRES_PASSWORD=commerce_dev_password
COMMERCE_POSTGRES_HOST=127.0.0.1
COMMERCE_POSTGRES_PORT=5433

# PostgreSQL analytical warehouse
WAREHOUSE_POSTGRES_DB=analytics
WAREHOUSE_POSTGRES_USER=warehouse_app
WAREHOUSE_POSTGRES_PASSWORD=warehouse_dev_password
WAREHOUSE_POSTGRES_HOST=127.0.0.1
WAREHOUSE_POSTGRES_PORT=5434

# Kafka and Debezium
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_CONNECT_URL=http://127.0.0.1:8083

# Airflow
# Replace AIRFLOW_UID with the output of: id -u
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_PORT=5435
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=replace_with_a_local_secret
AIRFLOW_API_SECRET_KEY=replace_with_a_local_secret

# Replace with the absolute path to this repository.
COMMERCE_PROJECT_HOST_PATH=/absolute/path/to/p03-real-time-commerce-data-platform

# Replace with the output of:
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
